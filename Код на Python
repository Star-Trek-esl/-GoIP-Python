def check_and_save_first_row():
    global prev_first_row
    ussd_command = '*100#'

    url = 'http://192.168.8.1/default/en_US/tools.html'
    auth = ('admin', 'TUpKHML08I0Zr0J')
    response = requests.get(url, auth=auth)

    if response.status_code == 200:
        soup = BeautifulSoup(response.content, 'html.parser')
        sms_store_script = soup.find('script', string=re.compile('var sms='))

        if sms_store_script:
            sms_text = re.search(r'var sms=(.*);', sms_store_script.string).group(1)
            sms_list = eval(sms_text)
            current_first_row = sms_list[2]  # Получаем текущую первую строку

            if os.path.exists('sms_data.csv'):
                with open('sms_data.csv', mode='r', encoding='utf-8') as sms_file:
                    sms_reader = csv.reader(sms_file)
                    last_row = None
                    for row in sms_reader:
                        last_row = row
                    if last_row:
                        prev_first_row = ','.join(last_row)

            if current_first_row != prev_first_row:
                with open('sms_data.csv', mode='a', newline='', encoding='utf-8') as sms_file:
                    sms_writer = csv.writer(sms_file)
                    date, phone_number, message = map(str.strip, current_first_row.split(','))
                    source_encoding = chardet.detect(message.encode())['encoding']
                    decoded_message = message.encode(source_encoding).decode('utf-8', 'ignore')
                    sms_writer.writerow([date, phone_number, decoded_message])
                    print("Строка изменена и успешно записана в файл sms_data.csv.")
                    prev_first_row = current_first_row
            else:
                print("Строка осталась неизменной, данные не записаны.")

        send_ussd(ussd_command)  # Отправляем USSD команду после проверки строки

    else:
        print("Ошибка при получении страницы.")
